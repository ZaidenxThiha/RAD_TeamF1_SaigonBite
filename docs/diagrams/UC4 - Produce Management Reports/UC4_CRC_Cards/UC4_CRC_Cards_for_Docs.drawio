          <mxGeometry x="40" y="324" width="920" height="204" as="geometry" />
        </mxCell>
        <mxCell id="ReportCalculationController_h" value="&lt;font style='font-size:10px;font-weight:normal'&gt;«controller»&lt;/font&gt;&lt;br&gt;ReportCalculationController" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#2E7D4F;fontColor=#FFFFFF;strokeColor=#2E7D4F;fontSize=16;fontStyle=1;" vertex="1" parent="c_ReportCalculationController">
          <mxGeometry x="0" y="0" width="920" height="46" as="geometry" />
