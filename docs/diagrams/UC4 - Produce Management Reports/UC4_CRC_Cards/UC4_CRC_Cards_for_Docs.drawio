        <mxCell id="ReportCalculationController_s1" value="Responsibilities" style="rounded=0;html=1;fillColor=#E6F3EA;fontColor=#2E7D4F;strokeColor=#2E7D4F;fontSize=11;fontStyle=1;" vertex="1" parent="c_ReportCalculationController">
