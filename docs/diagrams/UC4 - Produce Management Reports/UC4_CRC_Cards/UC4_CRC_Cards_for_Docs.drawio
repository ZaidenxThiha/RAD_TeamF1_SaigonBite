        <mxCell id="ReportSelectionView_s2" value="Collaborators" style="rounded=0;html=1;fillColor=#E3EEF9;fontColor=#1F5F99;strokeColor=#1F5F99;fontSize=11;fontStyle=1;" vertex="1" parent="c_ReportSelectionView">
          <mxGeometry x="290" y="46" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ReportSelectionView_b1" value="• Display available report types.&lt;br&gt;• Allow the Manager to select a report type.&lt;br&gt;• Accept the start date and end date.&lt;br&gt;• Allow an optional hub filter for SALES reports only.&lt;br&gt;• Submit the report request.&lt;br&gt;• Display validation errors.&lt;br&gt;• Display a no-matching-records message." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#1F5F99;fillColor=#FFFFFF;" vertex="1" parent="c_ReportSelectionView">
          <mxGeometry x="0" y="68" width="290" height="136" as="geometry" />
        </mxCell>
        <mxCell id="ReportSelectionView_b2" value="• ReportController" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#1F5F99;fillColor=#FFFFFF;" vertex="1" parent="c_ReportSelectionView">
