        <mxCell id="ReportCalculationController_s2" value="Collaborators" style="rounded=0;html=1;fillColor=#E6F3EA;fontColor=#2E7D4F;strokeColor=#2E7D4F;fontSize=11;fontStyle=1;" vertex="1" parent="c_ReportCalculationController">
          <mxGeometry x="588" y="46" width="332" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ReportCalculationController_b1" value="• Calculate sales report metrics from retrieved order records.&lt;br&gt;• Calculate hub workload metrics from retrieved hub and order records.&lt;br&gt;• Calculate delivery-performance metrics from retrieved delivery records.&lt;br&gt;• Organize calculated metrics into ReportMetric objects.&lt;br&gt;• Produce the ReportResult for presentation." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#2E7D4F;fillColor=#FFFFFF;" vertex="1" parent="c_ReportCalculationController">
          <mxGeometry x="0" y="68" width="588" height="136" as="geometry" />
