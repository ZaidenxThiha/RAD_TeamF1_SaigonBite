        <mxCell id="OrderRepository_b1" value="• Retrieve orders within the selected date range.&lt;br&gt;• Retrieve matching orders for an optional hub filter where supported by the existing domain association.&lt;br&gt;• Supply the order records required for sales reporting and as the order input to hub workload reporting (orders only; Hub records are not retrieved here)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#6B4C9A;fillColor=#FFFFFF;" vertex="1" parent="c_OrderRepository">
