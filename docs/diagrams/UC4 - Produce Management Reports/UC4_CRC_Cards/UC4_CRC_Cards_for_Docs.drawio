        <mxCell id="ReportResultView_b1" value="• Display the generated report title.&lt;br&gt;• Display report metrics and summary information.&lt;br&gt;• Display the report generation timestamp.&lt;br&gt;• Display the total number of matching records.&lt;br&gt;• Present the report results for Manager review." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#1F5F99;fillColor=#FFFFFF;" vertex="1" parent="c_ReportResultView">
