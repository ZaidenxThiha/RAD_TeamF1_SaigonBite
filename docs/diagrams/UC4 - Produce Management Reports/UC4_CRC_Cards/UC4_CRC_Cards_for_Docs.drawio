  <diagram id="p5" name="5. Flow and Notes">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5_ban" value="&lt;b&gt;Collaboration Flow, Report Paths and Notes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UC4 – Produce Management Reports · CRC Cards&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#37474F;fontColor=#FFFFFF;strokeColor=#37474F;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="920" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_steps" value="&lt;b&gt;Collaboration flow&lt;/b&gt;&lt;br&gt;1  Manager selects report type, date range (hub filter for SALES only) in ReportSelectionView.&lt;br&gt;2  ReportSelectionView sends the selected criteria to ReportController.&lt;br&gt;3  ReportController validates the ReportRequest.&lt;br&gt;4  ReportController selects repositories according to ReportType.&lt;br&gt;5  Repositories retrieve the matching Order, Hub or Delivery records (read-only).&lt;br&gt;6  ReportController invokes ReportCalculationController with the retrieved records.&lt;br&gt;7  ReportCalculationController organizes ReportMetric objects into a ReportResult.&lt;br&gt;8  ReportController receives the generated ReportResult.&lt;br&gt;9  ReportController passes the ReportResult to ReportResultView.&lt;br&gt;10 ReportResultView displays the generated report to the Manager." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#9E9E9E;fillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="920" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f_paths" value="&lt;b&gt;Report paths (all converge into ReportResult → ReportResultView)&lt;/b&gt;&lt;br&gt;&lt;font color='#C62828'&gt;&lt;b&gt;SALES&lt;/b&gt;&lt;/font&gt; → OrderRepository → Order → ReportCalculationController&lt;br&gt;&lt;font color='#00838F'&gt;&lt;b&gt;HUB_WORKLOAD&lt;/b&gt;&lt;/font&gt; → HubRepository + OrderRepository → Hub + Order → ReportCalculationController&lt;br&gt;&lt;font color='#AD1457'&gt;&lt;b&gt;DELIVERY_PERFORMANCE&lt;/b&gt;&lt;/font&gt; → DeliveryRepository → Delivery → ReportCalculationController&lt;br&gt;&lt;br&gt;Optional hub filter applies to &lt;b&gt;SALES&lt;/b&gt; reports only." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#9E9E9E;fillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="920" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f_notes" value="&lt;b&gt;A-05 – Reporting Assumption&lt;/b&gt;&lt;br&gt;Reports use a selected date range and an optional hub filter. The optional hub filter is explicitly applicable to SALES reports (FR-16). Exact KPI definitions and calculation methods remain subject to client confirmation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Additional notes&lt;/b&gt;&lt;br&gt;• Invalid criteria result in validation feedback.&lt;br&gt;• No matching records result in an empty-result message.&lt;br&gt;• Report generation is read-only; no operational records are created, modified or deleted by UC4.&lt;br&gt;• No unconfirmed KPI calculation formulas are shown.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enumerations:&lt;/b&gt; ReportType {SALES, HUB_WORKLOAD, DELIVERY_PERFORMANCE}&lt;br&gt;ReportRequestStatus {REQUESTED, VALIDATING, PROCESSING, COMPLETED, EMPTY_RESULT, FAILED}" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=11;strokeColor=#9E9E9E;fillColor=#FFFFF0;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="920" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>