          <mxGeometry x="588" y="46" width="332" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ReportController_b1" value="• Receive report requests from ReportSelectionView.&lt;br&gt;• Validate the selected report criteria.&lt;br&gt;• Coordinate report data retrieval.&lt;br&gt;• Invoke the appropriate report calculation operation.&lt;br&gt;• Handle invalid criteria.&lt;br&gt;• Handle empty search results.&lt;br&gt;• Coordinate report generation.&lt;br&gt;• Pass the generated result to ReportResultView." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#2E7D4F;fillColor=#FFFFFF;" vertex="1" parent="c_ReportController">
          <mxGeometry x="0" y="68" width="588" height="136" as="geometry" />
        </mxCell>
        <mxCell id="ReportController_b2" value="• ReportSelectionView&lt;br&gt;• ReportResultView&lt;br&gt;• ReportRequest&lt;br&gt;• ReportCalculationController&lt;br&gt;• OrderRepository&lt;br&gt;• HubRepository&lt;br&gt;• DeliveryRepository&lt;br&gt;• ReportResult" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;fontSize=11;fontColor=#1A1A1A;strokeColor=#2E7D4F;fillColor=#FFFFFF;" vertex="1" parent="c_ReportController">
