          <mxGeometry x="0" y="46" width="290" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ReportResultView_s2" value="Collaborators" style="rounded=0;html=1;fillColor=#E3EEF9;fontColor=#1F5F99;strokeColor=#1F5F99;fontSize=11;fontStyle=1;" vertex="1" parent="c_ReportResultView">
