        <mxCell id="n1" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#17324d;" value="A-05: Management reports use selected date ranges and optional hub filters for Sales, Hub Workload and Delivery Performance. Exact KPI definitions, calculation methods and the applicability of the hub filter to each report category remain subject to client confirmation." vertex="1">
          <mxGeometry height="150" width="360" x="930" y="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#17324d;" value="A5 – No matching records: display an empty-result message; the Manager may revise the criteria or end the request. A6 – Data retrieval failure: display a retrieval error and inform the Manager that the report cannot currently be generated. These are distinct outcomes. UC4 is read-only; no operational records are created, updated or deleted. No export or email features are modeled." vertex="1">
          <mxGeometry height="150" width="360" x="930" y="290" as="geometry" />
        </mxCell>
