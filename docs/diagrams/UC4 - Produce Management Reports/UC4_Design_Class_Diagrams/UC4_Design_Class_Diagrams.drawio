0" y="978" width="1500" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC4_UI_Design_Class_Diagram" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="580" math="0" shadow="0"><root><mxCell id="p3-0"/><mxCell id="p3-1" parent="p3-0"/><mxCell id="p3-11" value="&lt;b&gt;UC4 – UI Design Class Diagram&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="p3-1"><mxGeometry x="300.0" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="p3-12" value="SaigonBite OFDH Platform | UC4 – Produce Management Reports | Author: 523K0073" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="p3-1"><mxGeometry x="300.0" y="40" width="800" height="20" as="geometry"/></mxCell><mxCell id="p3-13" value="&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;ReportSelectionView&lt;/b&gt;" style="swimlane;html=1;fontStyle=0;align=center;verticalAlign=top;startSize=46;collapsible=0;fillColor=#DCE9F8;strokeColor=#3B6EA8;strokeWidth=2;fontSize=14;fontColor=#222222;swimlaneFillColor=#DCE9F8;" vertex="1" parent="p3-1"><mxGeometry x="80" y="160" width="420" height="282" as="geometry"/></mxCell><mxCell id="p3-14" value="-reportType: ReportType&lt;br&gt;-startDate: Date&lt;br&gt;-endDate: Date&lt;br&gt;-selectedHubId: String [0..1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;whiteSpace=nowrap;overflow=hidden;fontSize=13;fontColor=#222222;" vertex="1" parent="p3-13"><mxGeometry y="46" width="420" height="88" as="geometry"/></mxCell><mxCell id="p3-15" value="" style="line;html=1;strokeWidth=1;fillColor=none;strokeColor=#3B6EA8;" vertex="1" parent="p3-13"><mxGeometry y="130" width="420" height="8" as="geometry"/></mxCell><mxCell id="p3-16" value="+displayReportOptions(): vo