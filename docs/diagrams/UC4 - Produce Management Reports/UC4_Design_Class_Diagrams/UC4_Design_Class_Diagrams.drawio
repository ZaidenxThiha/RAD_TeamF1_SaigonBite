ference»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p1-1"><mxGeometry x="776.0" y="577.0" width="78.0" height="18" as="geometry"/></mxCell><mxCell id="p1-59" value="«reference»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p1-1"><mxGeometry x="538.5" y="591.0" width="78.0" height="18" as="geometry"/></mxCell><mxCell id="p1-60" value="«reference»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p1-1"><mxGeometry x="943.5" y="591.0" width="78.0" height="18" as="geometry"/></mxCell><mxCell id="p1-61" value="Order, Hub and Delivery are reused from the SaigonBite Overall Domain Class Model; UC4 only reads them." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p1-1"><mxGeometry x="60" y="950" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p1-62" value="The optional hub filter (hubId) applies to SALES reports only (FR-16, Assumption A-05)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p1-1"><mxGeometry x="60" y="970" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p1-70" value="{hubId is applicable only to SALES reports}" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="p1-1"><mxGeometry x="60" y="580" width="250" height="40" as="geometry"/></mxCell><mxCell id="p1-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.3289;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-70" target="p1-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-63" value="ReportRequestStatus holds persistent request outcomes only: REQUESTED, COMPLETED, EMPTY_RESULT (no matching records) and FAILED (a real report-processing failure)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p1-1"><mxGeometry x="60" y="990" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p1-64" value="Transient state-machine states (report selection, criteria entry, VALIDATING, PROCESSING, invalid-criteria feedback) are workflow states and are not stored as ReportRequestStatus; invalid criteria return the manager to criteria entry and never set FAILED." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p1-1"><mxGeometry x="60" y="1010" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p1-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-29" target="p1-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1-75" value="&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;OrderStatus&lt;/b&gt;" style="swimlane;html=1;fontStyle=0;align=center;verticalAlign=top;startSize=54;collapsible=0;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1;fontSize=14;fontColor=#222222;swimlaneFillColor=#FAFAFA;dashed=1;" vertex="1" parent="p1-1"><mxGeometry x="740" y="860" width="150" height="54" as="geometry"/></mxCell><mxCell id="p1-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" par