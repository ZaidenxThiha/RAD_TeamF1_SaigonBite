n=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p5-1"><mxGeometry x="60" y="1868" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p5-108" value="Connectors may cross where they pass between layers; crossings carry no meaning. Dashed arrows are dependencies, solid arrows are associations." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p5-1"><mxGeometry x="60" y="1886" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p5-110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.3488;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.7381;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-25" target="p5-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.3289;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-25" target="p5-51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="591"/></Array></mxGeometry></mxCell><mxCell id="p5-112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=0.7488;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1978;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-25" target="p5-55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="522" y="1376"/></Array></mxGeometry></mxCell><mxCell id="p5-113" value="«use»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p5-1"><mxGeometry x="162.5" y="1050" width="44.9" height="18" as="geometry"/></mxCell><mxCell id="p5-114" value="«use»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p5-1"><mxGeometry x="499.5" y="1050" width="44.9" height="18" as="geometry"/></mxCell><mxCell id="p5-115" value="{hub filter available only when reportType = SALES}. The hub selection control is enabled only while SALES is selected." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="p5-1"><mxGeometry x="480" y="100" width="380" height="62" as="geometry"/></mxCell><mxCell id="p5-116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=0.0000;exitY=0.6452;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.0355;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-115" target="p5-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-117" value="validateFilters() validates reportType, the date range and the optional hubId. A hubId is rejected (handleInvalidCriteria) unless reportType = SALES, so no hub filter is ever passed to a repository for HUB_WORKLOAD or DELIVERY_PERFORMANCE." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="p5-1"><mxGeometry x="650" y="470" width="340" height="100" as="geometry"/></mxCell><mxCell id="p5-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=0.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.0901;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-117" target="p5-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-119" value="{hubId is applicable only to SALES reports}" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="p5-1"><mxGeometry x="185" y="1595" width="230" height="40" as="geometry"/></mxCell><mxCell id="p5-120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.6316;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-119" target="p5-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-109" value="ReportRequestStatus holds persistent request outcomes only: REQUESTED, COMPLETED, EMPTY_RESULT (no matching records) and FAILED (a real report-processing failure)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p5-1"><mxGeometry x="60" y="1904" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p5-121" value="Transient state-machine states (report selection, criteria entry, VALIDATING, PROCESSING, invalid-criteria feedback) are workflow states and are not stored as ReportRequestStatus; invalid criteria return the manager to criteria entry and never set FAILED." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p5-1"><mxGeometry x="60" y="1922" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p5-122" value="Repositories are read-only (find* operations only). Only OrderRepository.findOrdersByHub() accepts a hubId, and the controller calls it for SALES reports only." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p5-1"><mxGeometry x="60" y="1940" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p5-123" value="Report data retrieval: SALES → findOrdersByDateRange(), or findOrdersByHub() when a hub is selected; HUB_WORKLOAD → findAllHubs() and findOrdersByDateRange(); DELIVERY_PERFORMANCE → findDeliveriesByDateRange(). No hub filter is used outside SALES." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=nowrap;" vertex="1" parent="p5-1"><mxGeometry x="60" y="1958" width="1500" height="18" as="geometry"/></mxCell><mxCell id="p5-130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-39" target="p5-43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-133" value="&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;OrderStatus&lt;/b&gt;" style="swimlane;html=1;fontStyle=0;align=center;verticalAlign=top;startSize=54;collapsible=0;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1;fontSize=14;fontColor=#222222;swimlaneFillColor=#FAFAFA;dashed=1;" vertex="1" parent="p5-1"><mxGeometry x="1010" y="1084" width="150" height="54" as="geometry"/></mxCell><mxCell id="p5-134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-43" target="p5-133"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-135" value="Order.status: OrderStatus and Delivery.deliveryStatus: String follow the shared SaigonBite Overall Domain Class Model; UC4 does not redefine them." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="p5-1"><mxGeometry x="1010" y="1160" width="330" height="56" as="geometry"/></mxCell><mxCell id="p5-136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#666666;strokeWidth=1;dashed=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.9753;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-135" target="p5-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.6;dashed=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.8333;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="p5-1" source="p5-21" target="p5-55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1870" y="291"/><mxPoint x="1870" y="1580"/><mxPoint x="950" y="1580"/></Array></mxGeometry></mxCell><mxCell id="p5-138" value="«use»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p5-1"><mxGeometry x="1000" y="282" width="44.9" height="18" as="geometry"/></mxCell><mxCell id="p5-139" value="Receives" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p5-1"><mxGeometry x="585" y="1102" width="80" height="18" as="geometry"/></mxCell><mxCell id="p5-140" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p5-1"><mxGeometry x="464" y="1089" width="28" height="18" as="geometry"/></mxCell><mxCell id="p5-141" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="p5-1"><mxGeometry x="698" y="1089" width="28" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>